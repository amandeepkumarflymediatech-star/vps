<%- include('../layouts/header') %> <%- include('../layouts/sidebar') %>

<%
  const currentSearch = typeof search !== 'undefined' ? search : '';
  const currentStatusVal = typeof currentStatus !== 'undefined' ? currentStatus : '';
  const currentStartDate = typeof startDate !== 'undefined' ? startDate : '';
  const currentEndDate = typeof endDate !== 'undefined' ? endDate : '';
  const currentMinAmount = typeof minAmount !== 'undefined' ? minAmount : '';
  const currentMaxAmount = typeof maxAmount !== 'undefined' ? maxAmount : '';
  const currentSortBy = typeof sortBy !== 'undefined' ? sortBy : 'date';
  const currentSortOrder = typeof sortOrder !== 'undefined' ? sortOrder : 'desc';

  function buildUrl(override) {
    const params = {
      page: override.page !== undefined ? override.page : currentPage,
      status: override.status !== undefined ? override.status : currentStatusVal,
      search: override.search !== undefined ? override.search : currentSearch,
      startDate: override.startDate !== undefined ? override.startDate : currentStartDate,
      endDate: override.endDate !== undefined ? override.endDate : currentEndDate,
      minAmount: override.minAmount !== undefined ? override.minAmount : currentMinAmount,
      maxAmount: override.maxAmount !== undefined ? override.maxAmount : currentMaxAmount,
      sortBy: override.sortBy !== undefined ? override.sortBy : currentSortBy,
      sortOrder: override.sortOrder !== undefined ? override.sortOrder : currentSortOrder,
    };
    const parts = [];
    for (const [k, v] of Object.entries(params)) {
      if (v !== '' && v !== null && v !== undefined) {
        parts.push(encodeURIComponent(k) + '=' + encodeURIComponent(v));
      }
    }
    return '/admin/payments' + (parts.length ? '?' + parts.join('&') : '');
  }

  function formatLocalIso(dateStr) {
    if (!dateStr) return '';
    const d = new Date(dateStr);
    if (isNaN(d.getTime())) return '';
    const tzOffset = d.getTimezoneOffset() * 60000;
    return new Date(d.getTime() - tzOffset).toISOString().slice(0, 16);
  }
%>

<main
  class="bg-gray-100 min-h-screen px-3 sm:px-4 md:px-6 py-6 w-full md:ml-64 transition-all duration-300"
>
  <div class="w-full max-w-6xl mx-auto">
    <!-- ================= MOBILE HEADER ================= -->
    <div class="flex items-center justify-between mb-6 md:hidden">
      <button
        id="menuBtn"
        class="bg-gradient-to-br from-blue-600 via-indigo-600 to-purple-600 text-white px-3 py-2 rounded-lg shadow text-xl"
      >
        ☰
      </button>

      <h1 class="text-lg font-semibold text-gray-800">Payments</h1>

      <span
        class="bg-gray-200 text-gray-700 px-3 py-2 rounded-lg text-sm font-semibold"
      >
        Admin
      </span>
    </div>

    <!-- ================= DESKTOP HEADER ================= -->
    <div class="hidden md:flex items-center justify-between mb-6">
      <div>
        <h1 class="text-2xl font-bold text-gray-800">Payments</h1>
        <p class="text-xs text-gray-500 mt-1">Search, filter by date and amount, and track all payment transactions</p>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-xs font-semibold px-3 py-1.5 rounded-full bg-blue-50 text-blue-700 border border-blue-200">
          Total: <%= typeof totalPayments !== 'undefined' ? totalPayments : payments.length %> payments
        </span>
      </div>
    </div>

    <!-- ================= FILTER / SEARCH / DATE / AMOUNT BAR ================= -->
    <div class="bg-white p-4 rounded-xl shadow mb-5 border border-gray-100">
      <form action="/admin/payments" method="GET" class="space-y-3">
        <!-- Row 1: Search, Status, Sort & Submit -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-3 items-center">
          
          <!-- Search input (Span 4) -->
          <div class="relative lg:col-span-4">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-gray-400">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
            </span>
            <input
              type="text"
              name="search"
              value="<%= currentSearch %>"
              placeholder="Search user, email, Txn ID, amount..."
              class="w-full pl-9 pr-8 py-2 border border-gray-300 rounded-lg text-sm bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            />
            <% if (currentSearch) { %>
              <a
                href="<%= buildUrl({ search: '', page: 1 }) %>"
                class="absolute inset-y-0 right-0 flex items-center pr-2.5 text-gray-400 hover:text-gray-600 text-xs"
                title="Clear search"
              >
                ✕
              </a>
            <% } %>
          </div>

          <!-- Status Dropdown (Span 2) -->
          <div class="lg:col-span-2">
            <select name="status" class="w-full bg-white border border-gray-300 text-gray-700 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
              <option value="">All Statuses</option>
              <option value="PENDING" <%= currentStatusVal === 'PENDING' ? 'selected' : '' %>>Pending</option>
              <option value="SUCCESS" <%= currentStatusVal === 'SUCCESS' ? 'selected' : '' %>>Success</option>
              <option value="VERIFIED" <%= currentStatusVal === 'VERIFIED' ? 'selected' : '' %>>Verified</option>
              <option value="REJECTED" <%= currentStatusVal === 'REJECTED' ? 'selected' : '' %>>Rejected</option>
            </select>
          </div>

          <!-- Sort Select (Span 3) -->
          <div class="lg:col-span-3">
            <select
              onchange="const val = this.value.split(':'); document.getElementById('sortByInput').value = val[0]; document.getElementById('sortOrderInput').value = val[1];"
              class="w-full bg-white border border-gray-300 text-gray-700 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
            >
              <option value="date:desc" <%= currentSortBy === 'date' && currentSortOrder === 'desc' ? 'selected' : '' %>>Date: Newest First</option>
              <option value="date:asc" <%= currentSortBy === 'date' && currentSortOrder === 'asc' ? 'selected' : '' %>>Date: Oldest First</option>
              <option value="amount:desc" <%= currentSortBy === 'amount' && currentSortOrder === 'desc' ? 'selected' : '' %>>Amount: High to Low</option>
              <option value="amount:asc" <%= currentSortBy === 'amount' && currentSortOrder === 'asc' ? 'selected' : '' %>>Amount: Low to High</option>
            </select>
            <input type="hidden" id="sortByInput" name="sortBy" value="<%= currentSortBy %>" />
            <input type="hidden" id="sortOrderInput" name="sortOrder" value="<%= currentSortOrder %>" />
          </div>

          <!-- Submit & Reset Buttons (Span 3) -->
          <div class="lg:col-span-3 flex items-center gap-2">
            <button
              type="submit"
              class="flex-1 px-4 py-2 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-medium text-sm transition shadow-sm flex items-center justify-center gap-1.5"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path></svg>
              Filter
            </button>
            <% if (currentSearch || currentStatusVal || currentStartDate || currentEndDate || currentMinAmount || currentMaxAmount || currentSortBy !== 'date' || currentSortOrder !== 'desc') { %>
              <a
                href="/admin/payments"
                class="px-3 py-2 rounded-lg border border-gray-300 text-gray-600 hover:bg-gray-100 transition text-sm font-medium"
                title="Reset all filters"
              >
                Reset
              </a>
            <% } %>
          </div>
        </div>

        <!-- Row 2: Date & Amount Range Filters -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3 pt-3 border-t border-gray-100 text-xs">
          
          <!-- Date Filter Section -->
          <div class="flex flex-wrap items-center gap-2">
            <span class="font-semibold text-gray-700 flex items-center gap-1">
              <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
              </svg>
              Filter by Date:
            </span>

            <div class="flex items-center gap-1">
              <input
                type="date"
                id="startDate"
                name="startDate"
                value="<%= currentStartDate %>"
                title="Start Date"
                class="px-2 py-1 border border-gray-300 rounded-lg text-xs bg-white focus:outline-none focus:ring-1 focus:ring-blue-500"
              />
              <span class="text-gray-400">to</span>
              <input
                type="date"
                id="endDate"
                name="endDate"
                value="<%= currentEndDate %>"
                title="End Date"
                class="px-2 py-1 border border-gray-300 rounded-lg text-xs bg-white focus:outline-none focus:ring-1 focus:ring-blue-500"
              />
            </div>

            <!-- Quick Date Presets -->
            <div class="flex items-center gap-1">
              <%
                const todayStr = new Date().toISOString().slice(0, 10);
                const sevenDaysAgo = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000).toISOString().slice(0, 10);
                const thirtyDaysAgo = new Date(Date.now() - 30 * 24 * 60 * 60 * 1000).toISOString().slice(0, 10);
              %>
              <a href="<%= buildUrl({ page: 1, startDate: todayStr, endDate: todayStr }) %>" class="px-2 py-0.5 rounded bg-gray-100 hover:bg-gray-200 text-gray-600 font-medium transition text-[11px]">Today</a>
              <a href="<%= buildUrl({ page: 1, startDate: sevenDaysAgo, endDate: todayStr }) %>" class="px-2 py-0.5 rounded bg-gray-100 hover:bg-gray-200 text-gray-600 font-medium transition text-[11px]">7d</a>
              <a href="<%= buildUrl({ page: 1, startDate: thirtyDaysAgo, endDate: todayStr }) %>" class="px-2 py-0.5 rounded bg-gray-100 hover:bg-gray-200 text-gray-600 font-medium transition text-[11px]">30d</a>
            </div>
          </div>

          <!-- Amount Filter Section -->
          <div class="flex flex-wrap items-center gap-2">
            <span class="font-semibold text-gray-700 flex items-center gap-1">
              <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              Filter by Amount (₹):
            </span>

            <div class="flex items-center gap-1">
              <div class="relative">
                <span class="absolute inset-y-0 left-0 pl-2 flex items-center text-gray-400 text-xs">₹</span>
                <input
                  type="number"
                  name="minAmount"
                  value="<%= currentMinAmount %>"
                  placeholder="Min"
                  step="any"
                  class="w-20 pl-5 pr-1.5 py-1 border border-gray-300 rounded-lg text-xs bg-white focus:outline-none focus:ring-1 focus:ring-blue-500"
                />
              </div>
              <span class="text-gray-400">to</span>
              <div class="relative">
                <span class="absolute inset-y-0 left-0 pl-2 flex items-center text-gray-400 text-xs">₹</span>
                <input
                  type="number"
                  name="maxAmount"
                  value="<%= currentMaxAmount %>"
                  placeholder="Max"
                  step="any"
                  class="w-20 pl-5 pr-1.5 py-1 border border-gray-300 rounded-lg text-xs bg-white focus:outline-none focus:ring-1 focus:ring-blue-500"
                />
              </div>
            </div>

            <!-- Quick Amount Presets -->
            <div class="flex items-center gap-1">
              <a href="<%= buildUrl({ page: 1, minAmount: '', maxAmount: '500' }) %>" class="px-2 py-0.5 rounded bg-gray-100 hover:bg-gray-200 text-gray-600 font-medium transition text-[11px]">&lt; ₹500</a>
              <a href="<%= buildUrl({ page: 1, minAmount: '500', maxAmount: '2000' }) %>" class="px-2 py-0.5 rounded bg-gray-100 hover:bg-gray-200 text-gray-600 font-medium transition text-[11px]">₹500-2k</a>
              <a href="<%= buildUrl({ page: 1, minAmount: '2000', maxAmount: '' }) %>" class="px-2 py-0.5 rounded bg-gray-100 hover:bg-gray-200 text-gray-600 font-medium transition text-[11px]">&gt; ₹2k</a>
            </div>
          </div>

        </div>
      </form>
    </div>

    <!-- Active Filter Indicators -->
    <% if (currentSearch || currentStatusVal || currentStartDate || currentEndDate || currentMinAmount || currentMaxAmount) { %>
      <div class="flex flex-wrap items-center gap-2 mb-4 text-xs">
        <span class="text-gray-500 font-medium">Active Filters:</span>
        <% if (currentSearch) { %>
          <span class="inline-flex items-center gap-1 px-2.5 py-1 bg-blue-50 border border-blue-200 text-blue-700 rounded-full font-medium">
            Search: "<%= currentSearch %>"
            <a href="<%= buildUrl({ search: '', page: 1 }) %>" class="hover:text-blue-900 font-bold ml-0.5" title="Remove search filter">&times;</a>
          </span>
        <% } %>
        <% if (currentStatusVal) { %>
          <span class="inline-flex items-center gap-1 px-2.5 py-1 bg-indigo-50 border border-indigo-200 text-indigo-700 rounded-full font-medium">
            Status: <%= currentStatusVal %>
            <a href="<%= buildUrl({ status: '', page: 1 }) %>" class="hover:text-indigo-900 font-bold ml-0.5" title="Remove status filter">&times;</a>
          </span>
        <% } %>
        <% if (currentStartDate || currentEndDate) { %>
          <span class="inline-flex items-center gap-1 px-2.5 py-1 bg-emerald-50 border border-emerald-200 text-emerald-700 rounded-full font-medium">
            Date: <%= currentStartDate || 'Start' %> → <%= currentEndDate || 'Now' %>
            <a href="<%= buildUrl({ startDate: '', endDate: '', page: 1 }) %>" class="hover:text-emerald-900 font-bold ml-0.5" title="Remove date filter">&times;</a>
          </span>
        <% } %>
        <% if (currentMinAmount || currentMaxAmount) { %>
          <span class="inline-flex items-center gap-1 px-2.5 py-1 bg-amber-50 border border-amber-200 text-amber-700 rounded-full font-medium">
            Amount: ₹<%= currentMinAmount || '0' %> - <%= currentMaxAmount ? '₹' + currentMaxAmount : 'Any' %>
            <a href="<%= buildUrl({ minAmount: '', maxAmount: '', page: 1 }) %>" class="hover:text-amber-900 font-bold ml-0.5" title="Remove amount filter">&times;</a>
          </span>
        <% } %>
        <a href="/admin/payments" class="text-blue-600 hover:underline font-semibold ml-1">Clear all</a>
      </div>
    <% } %>

    <!-- ================= PAYMENTS TABLE (DESKTOP) ================= -->
    <div class="hidden md:block bg-white rounded-xl shadow border border-gray-100 overflow-x-auto">
      <table class="min-w-full text-sm text-left">
        <thead class="bg-gray-50 text-gray-600 uppercase text-xs">
          <tr>
            <!-- Date Column with Sort Toggle -->
            <th class="px-4 py-3">
              <a
                href="<%= buildUrl({ page: 1, sortBy: 'date', sortOrder: currentSortBy === 'date' && currentSortOrder === 'desc' ? 'asc' : 'desc' }) %>"
                class="inline-flex items-center gap-1 font-semibold text-gray-700 hover:text-blue-600 transition"
                title="Sort by Date"
              >
                Date
                <% if (currentSortBy === 'date') { %>
                  <span class="text-blue-600 font-bold"><%= currentSortOrder === 'asc' ? '▲' : '▼' %></span>
                <% } else { %>
                  <span class="text-gray-300">↕</span>
                <% } %>
              </a>
            </th>

            <th class="px-4 py-3">User</th>
            <th class="px-4 py-3">Email</th>

            <!-- Amount Column with Sort Toggle -->
            <th class="px-4 py-3">
              <a
                href="<%= buildUrl({ page: 1, sortBy: 'amount', sortOrder: currentSortBy === 'amount' && currentSortOrder === 'desc' ? 'asc' : 'desc' }) %>"
                class="inline-flex items-center gap-1 font-semibold text-gray-700 hover:text-blue-600 transition"
                title="Sort by Amount"
              >
                Amount
                <% if (currentSortBy === 'amount') { %>
                  <span class="text-blue-600 font-bold"><%= currentSortOrder === 'asc' ? '▲' : '▼' %></span>
                <% } else { %>
                  <span class="text-gray-300">↕</span>
                <% } %>
              </a>
            </th>

            <th class="px-4 py-3">Method</th>
            <th class="px-4 py-3">Status</th>
            <th class="px-4 py-3 text-right">Action</th>
          </tr>
        </thead>

        <tbody class="divide-y divide-gray-100">
          <% if (!payments || !payments.length) { %>
          <tr>
            <td colspan="7" class="px-4 py-10 text-center text-gray-500">
              <p class="text-base font-medium">No payments found</p>
              <p class="text-xs text-gray-400 mt-1">Try adjusting your date range, amount range, or search criteria.</p>
              <% if (currentSearch || currentStatusVal || currentStartDate || currentEndDate || currentMinAmount || currentMaxAmount) { %>
                <a href="/admin/payments" class="mt-3 inline-block px-3.5 py-1.5 bg-blue-50 text-blue-600 rounded-lg text-xs font-semibold hover:bg-blue-100 transition">Reset All Filters</a>
              <% } %>
            </td>
          </tr>
          <% } %> <% payments.forEach(p => { %>
          <tr class="hover:bg-gray-50 transition" id="row-payment-<%= p._id %>">
            <!-- Date Cell -->
            <td class="px-4 py-3 text-xs text-gray-700 whitespace-nowrap">
              <div class="font-medium text-gray-900">
                <%= p.createdAt ? new Date(p.createdAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : '-' %>
              </div>
              <span class="text-[11px] text-gray-400">
                <%= p.createdAt ? new Date(p.createdAt).toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' }) : '' %>
              </span>
            </td>

            <td class="px-4 py-3 font-medium text-gray-800">
              <%= p.userId ? p.userId.name : '-' %>
            </td>

            <td class="px-4 py-3 text-gray-600"><%= p.userId ? p.userId.email : '-' %></td>

            <!-- Amount Cell -->
            <td class="px-4 py-3 font-bold text-gray-900 whitespace-nowrap">
              ₹<%= p.amount %>
            </td>

            <td class="px-4 py-3 text-xs font-medium text-gray-500">
              <span class="px-2 py-0.5 bg-gray-100 rounded text-gray-600 font-mono"><%= p.method || 'UPI' %></span>
            </td>

            <!-- Status Badge Cell -->
            <td class="px-4 py-3">
              <span
                class="px-2.5 py-1 rounded-full text-xs font-semibold <%= p.status === 'SUCCESS' || p.status === 'VERIFIED' ? 'bg-green-100 text-green-700' : p.status === 'REJECTED' ? 'bg-red-100 text-red-700' : 'bg-yellow-100 text-yellow-700' %>"
              >
                <%= p.status %>
              </span>
            </td>

            <!-- Action Column -->
            <td class="px-4 py-3 text-right whitespace-nowrap">
              <a
                href="/admin/payments/<%= p._id %>"
                class="inline-flex items-center gap-1 text-xs font-semibold px-3 py-1.5 rounded-lg bg-blue-50 text-blue-700 hover:bg-blue-100 transition"
              >
                View Details
              </a>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <!-- ================= PAYMENTS CARDS (MOBILE) ================= -->
    <div class="md:hidden space-y-4">
      <% if (!payments || !payments.length) { %>
        <div class="bg-white rounded-xl border p-8 text-center text-gray-500">
          <p class="text-base font-medium">No payments found</p>
          <a href="/admin/payments" class="mt-2 inline-block px-3 py-1 bg-blue-50 text-blue-600 rounded-lg text-xs font-semibold hover:bg-blue-100">Reset Filters</a>
        </div>
      <% } else { %>
        <% payments.forEach(p => { %>
          <div class="bg-white rounded-xl shadow border p-4 space-y-3" id="card-payment-<%= p._id %>">
            <div class="flex justify-between items-start">
              <div>
                <p class="font-bold text-gray-800"><%= p.userId ? p.userId.name : '-' %></p>
                <div class="text-[11px] text-gray-500"><%= p.userId ? p.userId.email : '-' %></div>
              </div>
              <span
                class="px-2.5 py-1 rounded-full text-[10px] font-bold uppercase <%= p.status === 'SUCCESS' || p.status === 'VERIFIED' ? 'bg-green-100 text-green-700' : p.status === 'REJECTED' ? 'bg-red-100 text-red-700' : 'bg-yellow-100 text-yellow-700' %>"
              >
                <%= p.status %>
              </span>
            </div>

            <!-- Date Row in Mobile Card -->
            <div class="flex items-center text-xs text-gray-600 bg-gray-50 px-2.5 py-1.5 rounded-lg border border-gray-100">
              <svg class="w-4 h-4 mr-1.5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
              </svg>
              <span class="font-medium">
                <%= p.createdAt ? new Date(p.createdAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : '-' %>
              </span>
            </div>
            
            <div class="flex justify-between items-center text-xs">
              <p class="font-bold text-lg text-gray-900">₹<%= p.amount %></p>
              <div class="text-right">
                <p class="text-gray-400 font-bold uppercase text-[9px]">Method</p>
                <p class="bg-gray-100 px-2 py-0.5 rounded text-gray-600 font-mono inline-block"><%= p.method || 'UPI' %></p>
              </div>
            </div>

            <div class="pt-1 border-t">
              <a
                href="/admin/payments/<%= p._id %>"
                class="block w-full text-center bg-gray-50 hover:bg-gray-100 text-blue-600 py-2 rounded-lg text-xs font-semibold border transition"
              >
                View Details
              </a>
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>

    <!-- ================= PAGINATION ================= -->
    <div class="flex flex-col sm:flex-row items-center justify-between mt-6 mb-4 gap-4">
      <p class="text-sm text-gray-600 whitespace-nowrap">
        Showing <span class="font-semibold"><%= typeof payments !== 'undefined' && payments.length > 0 ? ((currentPage - 1) * limit) + 1 : 0 %></span> to <span class="font-semibold"><%= ((currentPage - 1) * limit) + (typeof payments !== 'undefined' ? payments.length : 0) %></span> of <span class="font-semibold"><%= typeof totalPayments !== 'undefined' ? totalPayments : 0 %></span> results
      </p>

      <% if (totalPages > 1) { %>
      <div class="flex items-center gap-1.5 overflow-x-auto pb-2 sm:pb-0">
        <a
          href="<%= buildUrl({ page: currentPage - 1 }) %>"
          class="px-3 py-2 rounded-lg border text-sm font-medium <%= currentPage === 1 ? 'pointer-events-none opacity-50 bg-gray-100' : 'hover:bg-gray-100' %>"
        >
          Prev
        </a>

        <% 
        let startPage = Math.max(1, currentPage - 2);
        let endPage = Math.min(totalPages, currentPage + 2);
        
        if (startPage > 1) { 
        %>
          <a href="<%= buildUrl({ page: 1 }) %>" class="px-3 py-2 rounded-lg text-sm font-medium border hover:bg-gray-100">1</a>
          <% if (startPage > 2) { %>
            <span class="px-2 py-2 text-gray-400">...</span>
          <% } %>
        <% } %>

        <% for (let i = startPage; i <= endPage; i++) { %>
        <a
          href="<%= buildUrl({ page: i }) %>"
          class="px-3 py-2 rounded-lg text-sm font-medium border <%= i === currentPage ? 'bg-blue-600 text-white border-blue-600' : 'hover:bg-gray-100' %>"
        >
          <%= i %>
        </a>
        <% } %>

        <% if (endPage < totalPages) { %>
          <% if (endPage < totalPages - 1) { %>
            <span class="px-2 py-2 text-gray-400">...</span>
          <% } %>
          <a href="<%= buildUrl({ page: totalPages }) %>" class="px-3 py-2 rounded-lg text-sm font-medium border hover:bg-gray-100"><%= totalPages %></a>
        <% } %>

        <a
          href="<%= buildUrl({ page: currentPage + 1 }) %>"
          class="px-3 py-2 rounded-lg border text-sm font-medium <%= currentPage === totalPages ? 'pointer-events-none opacity-50 bg-gray-100' : 'hover:bg-gray-100' %>"
        >
          Next
        </a>
      </div>
      <% } %>
    </div>
  </div>
</main>

<%- include('../layouts/footer') %>
