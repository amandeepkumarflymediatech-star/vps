<%- include('layouts/header') %> <%- include('layouts/sidebar') %>

<main
  class="bg-gray-100 min-h-screen flex justify-center px-3 sm:px-4 md:px-6 py-6 w-full md:ml-64 transition-all"
>
  <!-- CONTENT WRAPPER -->
  <div class="w-full max-w-7xl">
    <!-- ================= MOBILE HEADER ================= -->
    <div class="flex items-center justify-between mb-6 md:hidden">
      <button
        class="menu-btn bg-gradient-to-br from-blue-600 via-indigo-600 to-purple-600 text-white px-3 py-2 rounded-lg shadow"
      >
        ☰
      </button>

      <h1 class="text-lg font-semibold text-gray-800">User List</h1>

      <a
        href="/admin/users/adduser"
        class="bg-gradient-to-br from-blue-600 via-indigo-600 to-purple-600 text-white px-3 py-2 rounded-lg text-sm shadow"
      >
        + Add
      </a>
    </div>

    <!-- ================= DESKTOP HEADER ================= -->
    <div class="hidden md:flex items-center justify-between mb-6">
      <h1 class="text-2xl font-semibold text-gray-800">User List</h1>

      <a
        href="/admin/users/adduser"
        class="text-sm bg-gradient-to-br from-blue-600 via-indigo-600 to-purple-600 text-white px-4 py-2 rounded-lg hover:opacity-90 transition"
      >
        + Add User
      </a>
    </div>

    <!-- ================= CARD ================= -->
    <div class="bg-white p-4 sm:p-5 md:p-6 rounded-2xl shadow-md">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3 mb-4">
        <div>
          <h2 class="text-lg md:text-xl font-semibold text-gray-700">Users</h2>
          <% if (typeof search !== 'undefined' && search) { %>
            <p class="text-xs text-gray-500 mt-0.5">
              Showing search results for <span class="font-semibold text-indigo-600">"<%= search %>"</span>
              <% if (roleFilter) { %>(Role: <%= roleFilter %>)<% } %> — <%= total %> user<%= total === 1 ? '' : 's' %> found
            </p>
          <% } else if (roleFilter) { %>
            <p class="text-xs text-gray-500 mt-0.5">Filtered by Role: <span class="font-semibold text-indigo-600"><%= roleFilter %></span> (<%= total %> users)</p>
          <% } %>
        </div>

        <!-- Filters / Search / Sorting -->
        <form method="GET" action="/admin/users" class="flex flex-wrap items-center gap-2 text-sm w-full md:w-auto">
          <!-- Search input with icon -->
          <div class="relative flex-1 sm:w-64 md:w-72">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-gray-400">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
            </span>
            <input
              type="text"
              name="search"
              value="<%= typeof search !== 'undefined' && search ? search : '' %>"
              placeholder="Search name, email, phone..."
              class="w-full pl-9 pr-8 py-1.5 border border-gray-300 rounded-lg text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
            />
            <% if (typeof search !== 'undefined' && search) { %>
              <a
                href="/admin/users<% if (roleFilter) { %>?role=<%= encodeURIComponent(roleFilter) %><% } %>"
                class="absolute inset-y-0 right-0 flex items-center pr-2.5 text-gray-400 hover:text-gray-600 text-xs"
                title="Clear search"
              >
                ✕
              </a>
            <% } %>
          </div>

          <label class="flex items-center gap-1.5 text-gray-600">
            <span>Role:</span>
            <select name="role" class="border border-gray-300 rounded-lg px-2 py-1.5 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
              <option value="" <%= !roleFilter ? 'selected' : '' %>>All</option>
              <!-- <option value="ADMIN" <%= roleFilter === 'ADMIN' ? 'selected' : '' %>>ADMIN</option> -->
              <option value="TUTOR" <%= roleFilter === 'TUTOR' ? 'selected' : '' %>>TUTOR</option>
              <option value="STUDENT" <%= roleFilter === 'STUDENT' ? 'selected' : '' %>>STUDENT</option>
            </select>
          </label>

          <input type="hidden" name="sortRole" value="<%= sortRole || '' %>" />

          <button
            type="submit"
            class="px-3.5 py-1.5 rounded-lg bg-gradient-to-br from-blue-600 via-indigo-600 to-purple-600 text-white font-medium hover:opacity-90 transition shadow-sm"
          >
            Search
          </button>

          <% if ((typeof search !== 'undefined' && search) || roleFilter) { %>
            <a
              href="/admin/users"
              class="px-3 py-1.5 rounded-lg border border-gray-300 text-gray-600 hover:bg-gray-100 transition text-sm font-medium"
              title="Reset search and filters"
            >
              Reset
            </a>
          <% } %>
        </form>
      </div>

      <% if (data && data.length > 0) { %>

      <!-- ================= DESKTOP TABLE ================= -->
      <div class="hidden md:block overflow-x-auto">
        <table class="min-w-full text-sm border-collapse">
          <thead>
            <tr class="border-b bg-gray-50 text-gray-600">
              <th class="py-3 px-4 text-left">Name</th>
              <th class="py-3 px-4 text-left">Email</th>
              <th class="py-3 px-4 text-left">
                <div class="flex items-center gap-2">
                  <span>Role</span>
                  <a
                    href="/admin/users?sortRole=<%= sortRole === 'asc' ? 'desc' : 'asc' %><% if (roleFilter) { %>&role=<%= encodeURIComponent(roleFilter) %><% } %><% if (typeof search !== 'undefined' && search) { %>&search=<%= encodeURIComponent(search) %><% } %>"
                    class="text-xs text-gray-500 hover:text-gray-800"
                    title="Sort by role"
                  >
                    <%= sortRole === 'asc' ? '▲' : sortRole === 'desc' ? '▼' : '↕' %>
                  </a>
                </div>
              </th>
              <th class="py-3 px-4 text-left">Phone</th>
              <th class="py-3 px-4 text-left">Status</th>
              <th class="py-3 px-4 text-left">Action</th>
            </tr>
          </thead>

          <tbody>
            <% data.forEach(item => { %>
            <tr class="border-b hover:bg-gray-50 transition">
              <td class="py-3 px-4 font-medium uppercase"><%= item.name %></td>
              <td class="py-3 px-4 break-all"><%= item.email %></td>
              <td class="py-3 px-4"><%= item.role %></td>
              <td class="py-3 px-4"><%= item.phone %></td>
              <td class="py-3 px-4">
                <span
                  class="status-toggle cursor-pointer px-3 py-1 rounded-full text-sm font-semibold <%= item.status==='ACTIVE' ? 'bg-green-100 text-green-700' : 'bg-yellow-100 text-yellow-700' %>"
                  data-id="<%= item._id %>"
                  data-status="<%= item.status %>"
                >
                  <%= item.status==="ACTIVE" ? "Active" : "Pending" %>
                </span>
              </td>
              <td class="py-3 px-4">
                <a
                  href="/admin/users/<%= item._id %>"
                  class="text-blue-600 hover:underline"
                >
                  View
                </a>

                <span
                  class="delete-btn cursor-pointer px-3 py-1 rounded-full text-sm font-semibold text-red-500"
                  data-id="<%= item._id %>"
                  >Delete</span
                >
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <!-- ================= MOBILE / TABLET CARDS ================= -->
      <div class="md:hidden grid grid-cols-1 sm:grid-cols-2 gap-4">
        <% data.forEach(item => { %>
        <div class="border rounded-xl p-4 shadow-sm bg-gray-50">
          <p class="font-semibold uppercase text-gray-800"><%= item.name %></p>

          <p class="text-sm break-all text-gray-600 mt-1">
            <strong>Email:</strong> <%= item.email %>
          </p>

          <p class="text-sm text-gray-600">
            <strong>Role:</strong> <%= item.role %>
          </p>

          <p class="text-sm text-gray-600">
            <strong>Phone:</strong> <%= item.phone %>
          </p>

          <span
            class="inline-block mt-2 px-3 py-1 rounded-full text-xs font-semibold <%= item.status === 'ACTIVE' ? 'bg-green-100 text-green-700' : 'bg-yellow-100 text-yellow-700' %>"
          >
            <%= item.status === "ACTIVE" ? "Active" : "Pending" %>
          </span>

          <div class="mt-4">
            <a
              href="/admin/users/<%= item._id %>"
              class="inline-block text-blue-600 font-medium"
            >
              View Details →
            </a>
          </div>
        </div>
        <% }) %>
      </div>

      
      <!-- Pagination -->
      <% if (typeof page !== 'undefined' && typeof totalPages !== 'undefined' && totalPages > 1) { %>
      <div class="mt-4 flex flex-col sm:flex-row items-center justify-between gap-2 text-sm text-gray-600">
        <div>
          Page <span class="font-semibold"><%= page %></span> of <span class="font-semibold"><%= totalPages %></span>
          (<%= total %> users)
        </div>
        <div class="space-x-2">
          <% if (page > 1) { %>
            <a
              href="/admin/users?page=<%= page - 1 %>&limit=<%= limit %><% if (roleFilter) { %>&role=<%= encodeURIComponent(roleFilter) %><% } %><% if (sortRole) { %>&sortRole=<%= sortRole %><% } %><% if (typeof search !== 'undefined' && search) { %>&search=<%= encodeURIComponent(search) %><% } %>"
              class="px-3 py-1 border rounded-lg bg-white hover:bg-gray-50"
            >
              Previous
            </a>
          <% } %>
          <% if (page < totalPages) { %>
            <a
              href="/admin/users?page=<%= page + 1 %>&limit=<%= limit %><% if (roleFilter) { %>&role=<%= encodeURIComponent(roleFilter) %><% } %><% if (sortRole) { %>&sortRole=<%= sortRole %><% } %><% if (typeof search !== 'undefined' && search) { %>&search=<%= encodeURIComponent(search) %><% } %>"
              class="px-3 py-1 border rounded-lg bg-white hover:bg-gray-50"
            >
              Next
            </a>
          <% } %>
        </div>
      </div>
      <% } %>

      <% } else { %>
        <div class="text-center py-12">
          <% if (typeof search !== 'undefined' && search) { %>
            <p class="text-gray-500 text-base">No users found matching "<span class="font-semibold text-gray-700"><%= search %></span>"<% if (roleFilter) { %> with role <span class="font-semibold text-gray-700"><%= roleFilter %></span><% } %>.</p>
            <a
              href="/admin/users"
              class="mt-3 inline-block px-4 py-1.5 bg-indigo-50 text-indigo-600 font-medium rounded-lg hover:bg-indigo-100 transition text-sm"
            >
              Clear Search & Show All Users
            </a>
          <% } else if (roleFilter) { %>
            <p class="text-gray-500 text-base">No users found with role "<span class="font-semibold text-gray-700"><%= roleFilter %></span>".</p>
            <a
              href="/admin/users"
              class="mt-3 inline-block px-4 py-1.5 bg-indigo-50 text-indigo-600 font-medium rounded-lg hover:bg-indigo-100 transition text-sm"
            >
              Reset Role Filter
            </a>
          <% } else { %>
            <p class="text-gray-500 text-base">No users found.</p>
          <% } %>
        </div>
      <% } %>
    </div>
  </div>
</main>

<%- include('layouts/footer') %>
