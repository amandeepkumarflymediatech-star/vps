<%- include('../layouts/header') %>
<%- include('../layouts/sidebar') %>

<main class="bg-gray-50 min-h-screen px-3 sm:px-4 md:px-6 py-6 w-full md:ml-64 transition-all duration-300">
  <div class="w-full max-w-2xl mx-auto">
    <div class="mb-8">
      <a href="/admin/coupons" class="text-blue-600 hover:underline text-sm mb-2 inline-block">← Back to list</a>
      <h1 class="text-2xl font-bold text-gray-800">Edit Coupon</h1>
    </div>

    <% if (locals.error) { %>
      <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-6">
        <%= error %>
      </div>
    <% } %>

    <div class="bg-white rounded-2xl shadow border p-6">
      <form action="/admin/coupons/edit/<%= coupon._id %>" method="POST" class="space-y-6">
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">Coupon Code</label>
          <input type="text" name="code" value="<%= coupon.code %>" placeholder="e.g. WELCOME50" required
                 class="w-full border border-gray-300 px-4 py-2 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none uppercase">
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Discount Type</label>
            <select name="discountType" class="w-full border border-gray-300 px-4 py-2 rounded-lg outline-none">
              <option value="PERCENTAGE" <%= coupon.discountType === 'PERCENTAGE' ? 'selected' : '' %>>Percentage (%)</option>
              <option value="FIXED" <%= coupon.discountType === 'FIXED' ? 'selected' : '' %>>Fixed Amount (INR)</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Value</label>
            <input type="number" name="discountValue" value="<%= coupon.discountValue %>" placeholder="10" required
                   class="w-full border border-gray-300 px-4 py-2 rounded-lg outline-none">
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Expiry Date</label>
            <input type="date" name="expiryDate" value="<%= new Date(coupon.expiryDate).toISOString().split('T')[0] %>" required
                   class="w-full border border-gray-300 px-4 py-2 rounded-lg outline-none">
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Usage Limit</label>
            <input type="number" name="usageLimit" value="<%= coupon.usageLimit %>" required
                   class="w-full border border-gray-300 px-4 py-2 rounded-lg outline-none">
          </div>
        </div>

        <div class="flex items-center gap-3">
          <input type="checkbox" name="isActive" id="isActive" <%= coupon.isActive ? 'checked' : '' %> class="w-4 h-4 text-blue-600">
          <label for="isActive" class="text-sm font-semibold text-gray-700">Is Active</label>
        </div>

        <button type="submit" class="w-full bg-blue-600 text-white font-bold py-3 rounded-lg hover:bg-blue-700 transition">
          Update Coupon
        </button>
      </form>
    </div>
  </div>
</main>

<%- include('../layouts/footer') %>
