<%- include('../layouts/header') %>
<%- include('../layouts/sidebar') %>

<body class="bg-gray-100 text-gray-800">
<main class="w-full md:ml-64 px-3 sm:px-6 py-6">
  <div class="max-w-7xl mx-auto">
    <!-- MOBILE HEADER -->
    <div class="flex items-center justify-between mb-6 md:hidden">
      <button class="menu-btn bg-blue-600 text-white px-4 py-2 rounded-lg shadow">
        ☰
      </button>
      <h1 class="text-lg font-semibold">Packages</h1>
      <a
        href="/admin/packages/add"
        class="bg-blue-600 text-white px-3 py-2 rounded-lg text-sm"
      >
        + Add
      </a>
    </div>

    <!-- DESKTOP HEADER -->
    <div class="hidden md:flex items-center justify-between mb-6">
      <h1 class="text-2xl font-semibold">Course Packages</h1>
      <a
        href="/admin/packages/add"
        class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition text-sm"
      >
        + Add Package
      </a>
    </div>

    <!-- ================= FILTER / SEARCH BAR ================= -->
    <div class="bg-white p-4 rounded-xl shadow mb-4">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3">
        <div>
          <span class="text-sm font-semibold text-gray-700">Filter Packages</span>
          <% if (typeof search !== 'undefined' && search) { %>
            <p class="text-xs text-gray-500 mt-0.5">
              Showing results for <span class="font-semibold text-blue-600">"<%= search %>"</span>
              <% if (typeof levelFilter !== 'undefined' && levelFilter) { %>(Level: <%= levelFilter %>)<% } %> — <%= typeof total !== 'undefined' ? total : packages.length %> found
            </p>
          <% } else if (typeof levelFilter !== 'undefined' && levelFilter) { %>
            <p class="text-xs text-gray-500 mt-0.5">Filtered by Level: <span class="font-semibold text-blue-600"><%= levelFilter %></span></p>
          <% } %>
        </div>

        <form method="GET" action="/admin/packages" class="flex flex-wrap items-center gap-2 text-sm w-full md:w-auto">
          <!-- Search input with icon -->
          <div class="relative flex-1 sm:w-64 md:w-72">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-gray-400">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
            </span>
            <input
              type="text"
              name="search"
              value="<%= typeof search !== 'undefined' && search ? search : '' %>"
              placeholder="Search title, category, description..."
              class="w-full pl-9 pr-8 py-1.5 border border-gray-300 rounded-lg text-sm bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            />
            <% if (typeof search !== 'undefined' && search) { %>
              <a
                href="/admin/packages<% if (typeof levelFilter !== 'undefined' && levelFilter) { %>?level=<%= encodeURIComponent(levelFilter) %><% } %>"
                class="absolute inset-y-0 right-0 flex items-center pr-2.5 text-gray-400 hover:text-gray-600 text-xs"
                title="Clear search"
              >
                ✕
              </a>
            <% } %>
          </div>

          <!-- Level Filter -->
          <label class="flex items-center gap-1.5 text-gray-600">
            <span>Level:</span>
            <select name="level" class="border border-gray-300 rounded-lg px-2 py-1.5 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
              <option value="" <%= typeof levelFilter === 'undefined' || !levelFilter ? 'selected' : '' %>>All Levels</option>
              <option value="BEGINNER" <%= typeof levelFilter !== 'undefined' && levelFilter === 'BEGINNER' ? 'selected' : '' %>>Beginner</option>
              <option value="INTERMEDIATE" <%= typeof levelFilter !== 'undefined' && levelFilter === 'INTERMEDIATE' ? 'selected' : '' %>>Intermediate</option>
              <option value="ADVANCED" <%= typeof levelFilter !== 'undefined' && levelFilter === 'ADVANCED' ? 'selected' : '' %>>Advanced</option>
            </select>
          </label>

          <!-- Status Filter -->
          <label class="flex items-center gap-1.5 text-gray-600">
            <span>Status:</span>
            <select name="status" class="border border-gray-300 rounded-lg px-2 py-1.5 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
              <option value="" <%= typeof statusFilter === 'undefined' || !statusFilter ? 'selected' : '' %>>All</option>
              <option value="published" <%= typeof statusFilter !== 'undefined' && statusFilter === 'published' ? 'selected' : '' %>>Published</option>
              <option value="draft" <%= typeof statusFilter !== 'undefined' && statusFilter === 'draft' ? 'selected' : '' %>>Draft</option>
            </select>
          </label>

          <input type="hidden" name="sortTitle" value="<%= typeof sortTitle !== 'undefined' ? sortTitle : '' %>" />

          <button
            type="submit"
            class="px-4 py-1.5 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-medium transition shadow-sm"
          >
            Search
          </button>

          <% if ((typeof search !== 'undefined' && search) || (typeof levelFilter !== 'undefined' && levelFilter) || (typeof statusFilter !== 'undefined' && statusFilter)) { %>
            <a
              href="/admin/packages"
              class="px-3 py-1.5 rounded-lg border border-gray-300 text-gray-600 hover:bg-gray-100 transition text-sm font-medium"
              title="Reset all filters"
            >
              Reset
            </a>
          <% } %>
        </form>
      </div>
    </div>

    <!-- DESKTOP TABLE -->
    <div class="hidden md:block bg-white rounded-xl shadow overflow-x-auto">
      <table class="min-w-full text-sm border-collapse">
        <thead>
          <tr class="border-b bg-gray-50 text-gray-600">
            <th class="py-3 px-4 text-left">
              <div class="flex items-center gap-2">
                <span>Title</span>
                <a
                  href="/admin/packages?sortTitle=<%= sortTitle === 'asc' ? 'desc' : 'asc' %><% if (typeof search !== 'undefined' && search) { %>&search=<%= encodeURIComponent(search) %><% } %><% if (typeof levelFilter !== 'undefined' && levelFilter) { %>&level=<%= encodeURIComponent(levelFilter) %><% } %><% if (typeof statusFilter !== 'undefined' && statusFilter) { %>&status=<%= encodeURIComponent(statusFilter) %><% } %>"
                  class="text-xs text-gray-500 hover:text-gray-800"
                  title="Sort by title"
                >
                  <%= sortTitle === 'asc' ? '▲' : sortTitle === 'desc' ? '▼' : '↕' %>
                </a>
              </div>
            </th>
            <th class="py-3 px-4 text-left">Courses</th>
            <th class="py-3 px-4 text-left">Level</th>
            <th class="py-3 px-4 text-left">Price</th>
            <th class="py-3 px-4 text-left">Status</th>
            <th class="py-3 px-4 text-left">Action</th>
          </tr>
        </thead>
        <tbody>
          <% if (!packages || packages.length === 0) { %>
            <tr>
              <td colspan="6" class="text-center py-8 text-gray-500">
                <% if (typeof search !== 'undefined' && search) { %>
                  <p class="text-base">No packages found matching "<span class="font-semibold text-gray-700"><%= search %></span>".</p>
                  <a href="/admin/packages" class="mt-2 inline-block px-3 py-1 bg-blue-50 text-blue-600 rounded-lg text-xs font-semibold hover:bg-blue-100">Clear Search</a>
                <% } else { %>
                  No packages found
                <% } %>
              </td>
            </tr>
          <% } %>

          <% packages.forEach(pkg => { %>
            <tr class="border-b hover:bg-gray-50 transition">
              <td class="py-3 px-4 font-medium">
                <%= pkg.title %>
              </td>
              <td class="py-3 px-4 text-xs text-gray-700">
                <% if (pkg.courses && pkg.courses.length) { %>
                  <%= pkg.courses.map(c => c.title).join(', ') %>
                <% } else { %>
                  -
                <% } %>
              </td>
              <td class="py-3 px-4">
                <%= pkg.level || '-' %>
              </td>
              <td class="py-3 px-4">
                ₹<%= pkg.price %>
                <% if (pkg.discountPrice) { %>
                  <span class="text-xs text-gray-500 line-through ml-1">
                    ₹<%= pkg.discountPrice %>
                  </span>
                <% } %>
              </td>
              <td class="py-3 px-4">
                <span
                  class="px-3 py-1 rounded-full text-xs font-semibold
                  <%= pkg.published
                    ? 'bg-green-100 text-green-700'
                    : 'bg-yellow-100 text-yellow-700' %>"
                >
                  <%= pkg.published ? 'Published' : 'Draft' %>
                </span>
              </td>
              <td class="py-3 px-4 space-x-4">
                <a
                  href="/admin/packages/edit/<%= pkg._id %>"
                  class="text-blue-600 hover:underline"
                >
                  Edit
                </a>
                <form
                  method="POST"
                  action="/admin/packages/delete/<%= pkg._id %>"
                  class="inline"
                  onsubmit="return confirm('Delete this package?')"
                >
                  <button class="text-red-600 hover:underline">
                    Delete
                  </button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <% if (typeof page !== 'undefined' && typeof totalPages !== 'undefined' && totalPages > 1) { %>
    <div class="mt-4 flex flex-col sm:flex-row items-center justify-between gap-2 text-sm text-gray-600">
      <div>
        Page <span class="font-semibold"><%= page %></span> of <span class="font-semibold"><%= totalPages %></span>
        (<%= total %> packages)
      </div>
      <div class="space-x-2">
        <% if (page > 1) { %>
          <a
            href="/admin/packages?page=<%= page - 1 %>&limit=<%= limit %><% if (sortTitle) { %>&sortTitle=<%= sortTitle %><% } %><% if (typeof search !== 'undefined' && search) { %>&search=<%= encodeURIComponent(search) %><% } %><% if (typeof levelFilter !== 'undefined' && levelFilter) { %>&level=<%= encodeURIComponent(levelFilter) %><% } %><% if (typeof statusFilter !== 'undefined' && statusFilter) { %>&status=<%= encodeURIComponent(statusFilter) %><% } %>"
            class="px-3 py-1 border rounded-lg bg-white hover:bg-gray-50"
          >
            Previous
          </a>
        <% } %>
        <% if (page < totalPages) { %>
          <a
            href="/admin/packages?page=<%= page + 1 %>&limit=<%= limit %><% if (sortTitle) { %>&sortTitle=<%= sortTitle %><% } %><% if (typeof search !== 'undefined' && search) { %>&search=<%= encodeURIComponent(search) %><% } %><% if (typeof levelFilter !== 'undefined' && levelFilter) { %>&level=<%= encodeURIComponent(levelFilter) %><% } %><% if (typeof statusFilter !== 'undefined' && statusFilter) { %>&status=<%= encodeURIComponent(statusFilter) %><% } %>"
            class="px-3 py-1 border rounded-lg bg-white hover:bg-gray-50"
          >
            Next
          </a>
        <% } %>
      </div>
    </div>
    <% } %>

    <!-- MOBILE CARDS -->
    <div class="md:hidden grid grid-cols-1 sm:grid-cols-2 gap-4 mt-4">
      <% packages.forEach(pkg => { %>
        <div class="bg-white border rounded-xl p-4 shadow-sm">
          <h3 class="font-semibold text-gray-800 mb-1">
            <%= pkg.title %>
          </h3>
          <p class="text-xs text-gray-600 mb-1">
            Courses:
            <% if (pkg.courses && pkg.courses.length) { %>
              <%= pkg.courses.map(c => c.title).join(', ') %>
            <% } else { %>
              -
            <% } %>
          </p>
          <p class="text-sm text-gray-700">
            Price: ₹<%= pkg.price %>
          </p>
          <span
            class="inline-block mt-2 px-3 py-1 rounded-full text-xs font-semibold
            <%= pkg.published
              ? 'bg-green-100 text-green-700'
              : 'bg-yellow-100 text-yellow-700' %>"
          >
            <%= pkg.published ? 'Published' : 'Draft' %>
          </span>
          <div class="mt-4 flex justify-between">
            <a
              href="/admin/packages/edit/<%= pkg._id %>"
              class="text-blue-600 font-medium"
            >
              Edit
            </a>
            <form
              method="POST"
              action="/admin/packages/delete/<%= pkg._id %>"
              onsubmit="return confirm('Delete this package?')"
            >
              <button class="text-red-600 font-medium">
                Delete
              </button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</main>

<%- include('../layouts/footer') %>
</body>
